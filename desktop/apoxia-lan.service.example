[Unit]
Description=Apoxia SketchBook LAN access
PartOf=graphical-session.target
Wants=apoxia-sketchbook.service
After=graphical-session-pre.target apoxia-sketchbook.service
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=__REPO_DIR__
ExecStart=/usr/bin/env node __REPO_DIR__/scripts/share-lan.mjs
Environment=PATH=%h/.local/share/mise/shims:/usr/local/bin:/usr/bin:/bin
Environment=APOXIA_LAN_HOST=__LAN_IP__
Environment=APOXIA_LAN_PORT=8765
Restart=always
RestartSec=3
TimeoutStopSec=15
UMask=0077

[Install]
WantedBy=graphical-session.target
