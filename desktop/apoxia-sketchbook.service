[Unit]
Description=Apoxia SketchBook desktop
PartOf=graphical-session.target
After=graphical-session-pre.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=%h/Work/referencias
ExecStart=%h/Work/referencias/node_modules/electron/dist/electron %h/Work/referencias
Environment=PATH=%h/.local/share/mise/shims:/usr/local/bin:/usr/bin:/bin
Environment=APOXIA_KEEP_SERVER=1
Restart=always
RestartSec=3
KillMode=mixed
TimeoutStopSec=300
UMask=0077

[Install]
WantedBy=graphical-session.target
