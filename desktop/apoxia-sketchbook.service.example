[Unit]
Description=Apoxia SketchBook desktop
PartOf=graphical-session.target
After=graphical-session-pre.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=__REPO_DIR__
ExecStart=__REPO_DIR__/node_modules/electron/dist/electron __REPO_DIR__
Environment=PATH=%h/.local/share/mise/shims:/usr/local/bin:/usr/bin:/bin
Environment=APOXIA_KEEP_SERVER=1
Restart=always
RestartSec=3
KillMode=mixed
TimeoutStopSec=300
UMask=0077

[Install]
WantedBy=graphical-session.target
