{
  "name": "apoxia-sketchbook-gpu",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "electron .",
    "start:web": "node server.js",
    "desktop:prepare": "node scripts/prepare-desktop-tools.mjs",
    "dist:linux": "electron-builder --linux --x64 --publish never",
    "dist:win": "electron-builder --win zip --x64 --publish never",
    "dist:linux:arm64": "electron-builder --linux --arm64 --publish never",
    "pack": "electron-builder --dir --publish never",
    "dist:win:installer": "electron-builder --win nsis portable --x64 --publish never",
    "share:lan": "node scripts/share-lan.mjs",
    "test": "node --test spatial.test.mjs svg-vector.test.mjs image-crop.test.mjs pinterest-media.test.mjs"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "devDependencies": {
    "electron": "44.10.1",
    "electron-builder": "26.15.3",
    "ffmpeg-static": "5.3.0",
    "ffprobe-static": "3.1.0"
  },
  "description": "Canvas local infinito para referencias, dibujos y notas con Vaults cifradas",
  "author": "Apoxia",
  "main": "desktop/main.cjs",
  "build": {
    "appId": "com.apoxia.sketchbook.gpu",
    "productName": "Apoxia SketchBook GPU",
    "asar": true,
    "npmRebuild": false,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "desktop/**",
      "desktop-bootstrap.js",
      "i18n.js",
      "locales/**",
      "server.js",
      "pinterest-media.js",
      "app.js",
      "index.html",
      "styles.css",
      "vault-storage.js",
      "vault-coordinates.js",
      "assets/**",
      "package.json",
      "build/icon.png",
      "gpu-renderer.js",
      "image-crop.js",
      "svg-vector.js",
      "svg-vector-worker.js",
      "gpu-worker.js",
      "gpu-spatial.js"
    ],
    "beforePack": "desktop/before-pack.cjs",
    "artifactName": "Apoxia-SketchBook-GPU-${version}-${os}-${arch}.${ext}",
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "category": "Graphics",
      "extraResources": [
        {
          "from": ".desktop-tools/linux-${arch}",
          "to": "tools"
        }
      ],
      "syncDesktopName": true
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "zip",
        "nsis",
        "portable"
      ],
      "extraResources": [
        {
          "from": ".desktop-tools/win32-${arch}",
          "to": "tools"
        }
      ],
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "Apoxia-SketchBook-${version}-windows-${arch}-portable.exe"
    },
    "extraResources": [
      {
        "from": "build/THIRD-PARTY-NOTICES.txt",
        "to": "THIRD-PARTY-NOTICES.txt"
      },
      {
        "from": "DESKTOP.md",
        "to": "DESKTOP.md"
      }
    ]
  },
  "license": "UNLICENSED",
  "desktopName": "apoxia-sketchbook-gpu.desktop",
  "dependencies": {
    "yauzl": "3.4.0",
    "yazl": "3.3.1"
  }
}
